---
interface Props {
  title?: string;
  path?: string;
}
const { title = "setyanoegraha", path = "/" } = Astro.props;
const nav = [
  { label: "./", href: "/", cmd: "cd /" },
  { label: "/proc", href: "/proc", cmd: "cd /proc" },
  { label: "/usr/bin", href: "/usr/bin", cmd: "cd /usr/bin" },
  { label: "/var/log", href: "/var/log", cmd: "cd /var/log" },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="setyanoegraha — security writeups, tools and projects." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' rx='3' fill='%230a0e14'/><text x='2' y='12' font-size='10' fill='%234af0a8'>$_</text></svg>" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #0a0e14;
        --fg: #c5c8d6;
        --dim: #6b7280;
        --green: #4af0a8;
        --blue: #7aa2f7;
        --yellow: #e0af68;
        --red: #f7768e;
        --border: #1f2430;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-monospace, "JetBrains Mono", "Fira Code", "Cascadia Code", Menlo, Consolas, monospace;
        font-size: 15px;
        line-height: 1.75;
        -webkit-font-smoothing: antialiased;
      }
      .window {
        max-width: 46rem;
        margin: 2.5rem auto 0;
        border: 1px solid var(--border);
        border-radius: 8px;
      }
      .titlebar {
        display: flex;
        align-items: center;
        padding: 0.5rem 1rem;
        border-bottom: 1px dashed var(--border);
        color: var(--dim);
        font-size: 0.78rem;
      }
      .titlebar .dots { display: inline-flex; gap: 0.45rem; }
      .titlebar .dot { width: 10px; height: 10px; border-radius: 50%; opacity: 0.8; }
      .titlebar .dot.r { background: var(--red); }
      .titlebar .dot.y { background: var(--yellow); }
      .titlebar .dot.g { background: var(--green); }
      .titlebar .label { margin: 0 auto; }
      main {
        padding: 2rem 1.25rem 3rem;
      }
      a { color: var(--blue); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      ::selection { background: var(--green); color: var(--bg); }

      .prompt {
        color: var(--dim);
        font-size: 0.85rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px dashed var(--border);
        margin-bottom: 2rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1rem;
        align-items: baseline;
      }
      .prompt .user { color: var(--green); }
      .prompt .sep { color: var(--dim); }
      .prompt .cwd { color: var(--blue); }
      .prompt nav { display: inline-flex; flex-wrap: wrap; gap: 0.9rem; }
      .prompt nav a { color: var(--fg); font-weight: 500; }
      .prompt nav a:hover { color: var(--green); text-decoration: none; }
      .prompt nav a[aria-current="page"] { color: var(--yellow); }
      .prompt .up { color: var(--red); }
      .prompt .up:hover { color: var(--fg); }

      .cmdline { margin: 1.5rem 0 0.75rem; }
      .cmdline::before { content: "$ "; color: var(--green); }
      h1.cmdline { font-size: 1.05rem; font-weight: 600; }
      h2.cmdline { font-size: 1rem; font-weight: 600; }

      footer {
        padding: 1.5rem 1.25rem 2.5rem;
        color: var(--dim);
        font-size: 0.8rem;
        border-top: 1px dashed var(--border);
      }
      footer .last-login { margin: 0 0 0.5rem; }
      footer .contact { margin: 0; }
      footer .exit { color: var(--green); }
      @media (max-width: 480px) {
        body { font-size: 13.5px; }
        .window { margin-top: 1rem; }
      }
    </style>
  </head>
  <body>
    <script is:inline>
      window.updateCwd = function (p) {
        var el = document.querySelector(".prompt .cwd");
        var label = p || "/";
        if (el) el.textContent = label;
        document.title = "setyanoegraha";
      };
    </script>
    <div class="window">
      <div class="titlebar">
        <span class="dots">
          <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
        </span>
        <span class="label">nugraha@setyanoegraha — bash</span>
      </div>
      <main>
      <div class="prompt">
        <span><span class="user">nugraha</span>@setyanoegraha:<span class="cwd">{path}</span>$</span>
        <nav>
          {nav.map((item) => (
            <a href={item.href} aria-current={current === item.href ? "page" : undefined} title={item.cmd}>{item.label}</a>
          ))}
          <a class="up" href="https://github.com/setyanoegraha" title="cd ../ (github)">../</a>
        </nav>
      </div>
      <slot />
    </main>
    <footer>
      <p class="contact">
        <span class="exit">exit 0</span> · <a href="mailto:pandu4688@gmail.com">mail</a> · <a href="https://www.linkedin.com/in/setyanoegraha/">linkedin</a> · <a href="https://github.com/setyanoegraha">github</a>
      </p>
    </footer>
    </div>
  </body>
</html>
