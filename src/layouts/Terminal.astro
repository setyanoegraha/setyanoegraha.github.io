---
interface Props {
  path?: string;
}
const { path = "/" } = Astro.props;
const fullTitle = path === "/" ? "setyanoegraha" : `setyanoegraha · ${path}`;
const workspaces = [
  { num: 1, label: "home", href: "/", cmd: "cd /" },
  { num: 2, label: "proc", href: "/proc", cmd: "cd /proc" },
  { num: 3, label: "bin", href: "/usr/bin", cmd: "cd /usr/bin" },
  { num: 4, label: "log", href: "/var/log", cmd: "cd /var/log" },
  { num: 5, label: "labs", href: "/srv/labs", cmd: "cd /srv/labs" },
];
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="setyanoegraha — security writeups, tools and projects." />
    <link rel="icon" href="https://github.com/setyanoegraha.png" />
    <meta name="referrer" content="no-referrer" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="setyanoegraha" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content="security writeups, tools and projects — presented as a terminal" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="https://github.com/setyanoegraha.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content="security writeups, tools and projects — presented as a terminal" />
    <meta name="twitter:image" content="https://github.com/setyanoegraha.png" />
    <link rel="canonical" href={Astro.url} />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        var theme = saved === "dark" || saved === "light"
          ? saved
          : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <style is:global>
      :root {
        color-scheme: light;
        --nord0:  #eceff4;
        --nord1:  #e5e9f0;
        --nord2:  #d8dee9;
        --nord3:  #4c566a;
        --nord4:  #2e3440;
        --nord7:  #2f6b70;
        --nord8:  #3a6b94;
        --nord9:  #44698f;
        --nord11: #a03b45;
        --nord12: #8a5127;
        --nord13: #7a5a1e;
        --nord14: #3f6b34;
        --nord15: #6f4a86;

        --bg:      var(--nord0);
        --bg-alt:  var(--nord1);
        --fg:      var(--nord4);
        --dim:     var(--nord3);
        --border:  var(--nord2);
        --green:   var(--nord14);
        --blue:    var(--nord8);
        --blue2:   var(--nord9);
        --accent:  #3a6b94;
        --accent-ink: #2f5f88;
        --chip-fg: #ffffff;
        --red:     var(--nord11);
        --orange:  var(--nord12);
        --yellow:  var(--nord13);
        --cyan:    var(--nord7);
      }

      :root[data-theme="dark"] {
        color-scheme: dark;
        --nord0:  #2e3440;
        --nord1:  #3b4252;
        --nord2:  #434c5e;
        --nord3:  #a8b0c0;
        --nord4:  #d8dee9;
        --nord7:  #8fbcbb;
        --nord8:  #88c0d0;
        --nord9:  #9db4cd;
        --nord11: #e2a2a8;
        --nord12: #dda483;
        --nord13: #ebcb8b;
        --nord14: #a3be8c;
        --nord15: #c4a6cf;

        --bg:      var(--nord0);
        --bg-alt:  var(--nord1);
        --fg:      var(--nord4);
        --dim:     var(--nord3);
        --border:  var(--nord2);
        --green:   var(--nord14);
        --blue:    var(--nord8);
        --blue2:   var(--nord9);
        --accent:  #4a6484;
        --accent-ink: #88c0d0;
        --chip-fg: #eceff4;
        --red:     var(--nord11);
        --orange:  var(--nord12);
        --yellow:  var(--nord13);
        --cyan:    var(--nord7);
      }
      * { box-sizing: border-box; border-radius: 0 !important; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-monospace, "JetBrains Mono", "Fira Code", "Cascadia Code", Menlo, Consolas, monospace;
        font-size: 15px;
        line-height: 1.75;
        -webkit-font-smoothing: antialiased;
      }

      .statusbar {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--bg-alt);
        border-bottom: 1px solid var(--border);
        padding: 0 0.5rem;
        height: 2rem;
        font-size: 0.78rem;
        flex-wrap: wrap;
      }
      .statusbar .workspaces {
        display: flex;
        gap: 0.15rem;
      }
      .statusbar .ws {
        padding: 0.2rem 0.5rem;
        color: var(--nord4);
        opacity: 0.75;
        text-decoration: none;
        cursor: pointer;
        line-height: 1.5;
      }
      .statusbar .ws:hover {
        color: var(--nord4);
        opacity: 0.85;
        text-decoration: none;
      }
      .statusbar .ws[aria-current="page"] {
        background: var(--accent);
        color: var(--chip-fg);
        font-weight: 600;
        opacity: 1;
      }
      .statusbar #theme-toggle {
        background: none;
        border: 1px solid var(--border);
        color: var(--fg);
        font-family: inherit;
        font-size: 0.75rem;
        padding: 0.1rem 0.5rem;
        cursor: pointer;
        min-height: 24px;
        margin-left: 0.75rem;
      }
      .statusbar #theme-toggle:hover { border-color: var(--accent-ink); color: var(--accent-ink); }
      .statusbar #theme-toggle:focus-visible { outline: 2px solid var(--accent-ink); outline-offset: 2px; }
      .statusbar #clock {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        color: var(--dim);
        font-variant-numeric: tabular-nums;
      }

      .terminal {
        max-width: 52rem;
        margin: 0 auto;
      }
      main {
        padding: 2rem 1.25rem 3rem;
      }
      a { color: var(--blue); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      :where(a, button, summary, input, [tabindex]):focus-visible {
        outline: 2px solid var(--accent-ink);
        outline-offset: 2px;
      }
      ::selection { background: var(--accent); color: var(--chip-fg); }

      .prompt {
        color: var(--dim);
        font-size: 0.85rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 2rem;
      }
      .prompt .user { color: var(--green); font-weight: 600; }
      .prompt .at { color: var(--dim); }
      .prompt .host { color: var(--blue2); font-weight: 600; }
      .prompt .colon { color: var(--dim); }
      .prompt .cwd { color: var(--blue); }
      .prompt .dollar { color: var(--green); }

      .cmdline { margin: 1.5rem 0 0.75rem; }
      .cmdline::before { content: "$ "; color: var(--green); }
      h1.cmdline { font-size: 1.05rem; font-weight: 600; }
      h2.cmdline { font-size: 1rem; font-weight: 600; }

      footer {
        padding: 1.5rem 1.25rem 2.5rem;
        color: var(--dim);
        font-size: 0.8rem;
        border-top: 1px solid var(--border);
      }
      footer .contact { margin: 0; }
      footer .exit { color: var(--green); }

      @media (max-width: 480px) {
        body { font-size: 13.5px; }
        .statusbar { height: auto; padding: 0.25rem 0.5rem; }
      }
      @media (max-width: 700px) {
        .statusbar #clock { display: none; }
      }
    </style>
  </head>
  <body>
    <script is:inline>
      window.updateCwd = function (p) {
        var el = document.querySelector(".prompt .cwd");
        var label = p || "/";
        if (el) el.textContent = label;
        document.title = label === "/" ? "setyanoegraha" : "setyanoegraha · " + label;
      };
    </script>
    <div class="statusbar">
      <div class="workspaces">
        {workspaces.map((ws) => (
          <a class="ws" href={ws.href} aria-current={current === ws.href ? "page" : undefined} title={ws.cmd}>
            {ws.num}:{ws.label}
          </a>
        ))}
      </div>
      <span id="clock">--:--</span>
      <button id="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">theme</button>
    </div>
    <div class="terminal">
      <main>
        <div class="prompt">
          <span class="user">nugraha</span><span class="at">@</span><span class="host">setyanoegraha</span><span class="colon">:</span><span class="cwd">{path}</span><span class="dollar">$</span>
        </div>
        <slot />
      </main>
      <footer>
        <p class="contact">
          <span class="exit">exit 0</span> · <a href="mailto:pandu4688@gmail.com">mail</a> · <a href="https://www.linkedin.com/in/setyanoegraha/">linkedin</a> · <a href="https://github.com/setyanoegraha">github</a>
        </p>
      </footer>
    </div>
    <script is:inline>
      (function () {
        function updateClock() {
          var el = document.getElementById("clock");
          if (!el) return;
          var fmt = new Intl.DateTimeFormat("en-GB", {
            timeZone: "Asia/Jakarta",
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
          });
          el.textContent = fmt.format(new Date()) + " WIB";
        }
        updateClock();
        setInterval(updateClock, 30000);
      })();
    </script>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        function sync() {
          var dark = document.documentElement.getAttribute("data-theme") === "dark";
          btn.textContent = dark ? "light" : "dark";
          btn.setAttribute("aria-pressed", String(dark));
          btn.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
        }
        btn.addEventListener("click", function () {
          var next =
            document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
