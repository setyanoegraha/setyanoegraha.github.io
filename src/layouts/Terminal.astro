---
interface Props {
  title?: string;
  path?: string;
}
const { title = "setyanoegraha", path = "/" } = Astro.props;
const workspaces = [
  { num: 1, label: "home", href: "/", cmd: "cd /" },
  { num: 2, label: "proc", href: "/proc", cmd: "cd /proc" },
  { num: 3, label: "bin", href: "/usr/bin", cmd: "cd /usr/bin" },
  { num: 4, label: "log", href: "/var/log", cmd: "cd /var/log" },
  { num: 5, label: "labs", href: "/srv/labs", cmd: "cd /srv/labs" },
];
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="setyanoegraha: security writeups, tools and projects." />
    <link rel="icon" href="https://github.com/setyanoegraha.png" />
    <meta name="referrer" content="no-referrer" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="setyanoegraha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="security writeups, tools and projects, presented as a terminal" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="https://github.com/setyanoegraha.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="security writeups, tools and projects, presented as a terminal" />
    <meta name="twitter:image" content="https://github.com/setyanoegraha.png" />
    <link rel="canonical" href={Astro.url} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        var theme = saved === "dark" || saved === "light"
          ? saved
          : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <style is:global>
      /* Reading this as: personal security portfolio for recruiters and peers,
         in a documented-terminal language, dial ENERGY 1 / RHYTHM 2 / MOTION 1.
         ENERGY 1: the audience reads long writeups, not a sales page.
         RHYTHM 2: the five workspaces already differ; only var/log varies further.
         MOTION 1: hover states and smooth scroll are the whole motion budget. */
      :root {
        color-scheme: light;
        --bg:        #fbfaf7;
        --bg-alt:    #f2efe9;
        --fg:        #23272e;
        --dim:       #5b6270;
        --border:    #d9d3c8;
        --green:     #2f6b3f;
        --blue:      #1f5f8b;
        --blue2:     #2f6b3f;
        --accent:    #1f5f8b;
        --red:       #a83232;
        --orange:    #8a5a12;
        --yellow:    #8a5a12;
        --purple:    #6b3fa0;
        --cyan:      #1c6b74;
        --font-sans: "Noto Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
        --font-mono: ui-monospace, "JetBrains Mono", "Fira Code", Menlo, Consolas, monospace;
        --nord0: var(--bg);
        --nord1: var(--bg-alt);
        --nord4: var(--fg);
        --nord5: var(--fg);
        --nord6: var(--fg);
        --nord8: var(--blue);
      }

      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg:       #2e3440;
        --bg-alt:   #3b4252;
        --fg:       #e5e9f0;
        --dim:      #b3bac9;
        --border:   #4c566a;
        --green:    #a3d9a5;
        --blue:     #8fb8d8;
        --blue2:    #8fb8d8;
        --accent:   #8fb8d8;
        --red:      #e89aa0;
        --orange:   #e0a07a;
        --yellow:   #ebcb8b;
        --purple:   #c9a9d4;
        --cyan:     #8fbcbb;
      }
      * { box-sizing: border-box; border-radius: 0 !important; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      .prompt, .cmdline, code, pre, kbd, .statusbar, .bin .name, .lab li a, #search-input {
        font-family: var(--font-mono);
      }

      h1.cmdline, h2.cmdline { letter-spacing: 0; }

      :where(a, button, summary, input, [tabindex]):focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .statusbar {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--bg-alt);
        border-bottom: 1px solid var(--border);
        padding: 0 0.5rem;
        height: 2rem;
        font-size: 0.78rem;
        flex-wrap: wrap;
      }
      .statusbar .workspaces {
        display: flex;
        gap: 0.15rem;
      }
      .statusbar .ws {
        padding: 0.1rem 0.5rem;
        color: var(--nord4);
        opacity: 0.55;
        text-decoration: none;
        cursor: pointer;
        line-height: 1.5;
      }
      .statusbar .ws:hover {
        color: var(--nord4);
        opacity: 0.85;
        text-decoration: none;
      }
      .statusbar .ws[aria-current="page"] {
        background: var(--accent);
        color: var(--nord6);
        font-weight: 600;
        opacity: 1;
      }
      .statusbar .sysinfo {
        display: flex;
        gap: 0.75rem;
        color: var(--nord5);
      }
      .statusbar .sysinfo .host { color: var(--nord5); }
      .statusbar .sysinfo .clock { color: var(--nord5); }
      .statusbar #theme-toggle {
        background: none;
        border: 1px solid var(--border);
        color: var(--fg);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        padding: 0.1rem 0.5rem;
        cursor: pointer;
        min-height: 24px;
        margin-left: 0.75rem;
      }
      .statusbar #theme-toggle:hover { border-color: var(--accent); color: var(--accent); }

      .terminal {
        max-width: 52rem;
        margin: 0 auto;
      }
      main {
        padding: 2rem 1.25rem 3rem;
      }
      a { color: var(--blue); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      ::selection { background: var(--accent); color: var(--nord6); }

      .prompt {
        color: var(--dim);
        font-size: 0.85rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 2rem;
      }
      .prompt .user { color: var(--green); font-weight: 600; }
      .prompt .at { color: var(--dim); }
      .prompt .host { color: var(--blue2); font-weight: 600; }
      .prompt .colon { color: var(--dim); }
      .prompt .cwd { color: var(--blue); }
      .prompt .dollar { color: var(--green); }

      .cmdline { margin: 1.5rem 0 0.75rem; }
      .cmdline::before { content: "$ "; color: var(--green); }
      h1.cmdline { font-size: 1.15rem; font-weight: 600; }
      h2.cmdline { font-size: 1.05rem; font-weight: 600; }

      footer {
        padding: 1.5rem 1.25rem 2.5rem;
        color: var(--dim);
        font-size: 0.8rem;
        border-top: 1px solid var(--border);
      }
      footer .contact { margin: 0; }
      footer .exit { color: var(--green); }

      @media (max-width: 480px) {
        body { font-size: 13.5px; }
        .statusbar { height: auto; padding: 0.25rem 0.5rem; }
        .statusbar .sysinfo { display: none; }
      }
    </style>
  </head>
  <body>
    <script is:inline>
      window.updateCwd = function (p) {
        var el = document.querySelector(".prompt .cwd");
        var label = p || "/";
        if (el) el.textContent = label;
        document.title = "setyanoegraha";
      };
    </script>
    <div class="statusbar">
      <div class="workspaces">
        {workspaces.map((ws) => (
          <a class="ws" href={ws.href} aria-current={current === ws.href ? "page" : undefined} title={ws.cmd}>
            {ws.num}:{ws.label}
          </a>
        ))}
      </div>
      <div class="sysinfo">
        <span class="host">setyanoegraha</span>
        <span class="clock" id="clock">--:--</span>
      </div>
      <button id="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">theme</button>
    </div>
    <div class="terminal">
      <main>
        <div class="prompt">
          <span class="user">nugraha</span><span class="at">@</span><span class="host">setyanoegraha</span><span class="colon">:</span><span class="cwd">{path}</span><span class="dollar">$</span>
        </div>
        <slot />
      </main>
      <footer>
        <p class="contact">
          <span class="exit">exit 0</span> · <a href="mailto:pandu4688@gmail.com">mail</a> · <a href="https://www.linkedin.com/in/setyanoegraha/">linkedin</a> · <a href="https://github.com/setyanoegraha">github</a>
        </p>
      </footer>
    </div>
    <script is:inline>
      (function () {
        function updateClock() {
          var el = document.getElementById("clock");
          if (!el) return;
          var fmt = new Intl.DateTimeFormat("en-GB", {
            timeZone: "Asia/Jakarta",
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
          });
          el.textContent = fmt.format(new Date()) + " WIB";
        }
        updateClock();
        setInterval(updateClock, 30000);
      })();
    </script>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        function sync() {
          var dark = document.documentElement.getAttribute("data-theme") === "dark";
          btn.textContent = dark ? "light" : "dark";
          btn.setAttribute("aria-pressed", String(dark));
          btn.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
        }
        btn.addEventListener("click", function () {
          var next =
            document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
