---
const fullTitle = "setyanoegraha";
const description =
  "Nugraha, computer engineering student at Semarang State Polytechnic. IT and security internship candidate. Projects, labs and writeups.";

const nav = [
  { label: "Projects", href: "/projects" },
  { label: "Milestones", href: "/milestones" },
  { label: "Writing", href: "/writing" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="https://github.com/setyanoegraha.png" />
    <meta name="referrer" content="no-referrer" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="setyanoegraha" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="https://github.com/setyanoegraha.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://github.com/setyanoegraha.png" />
    <link rel="canonical" href={Astro.url} />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        var theme = saved === "dark" || saved === "light"
          ? saved
          : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #faf9f5;
        --alt: #f3f1ea;
        --fg: #1f2023;
        --dim: #666666;
        --border: #e5e2d9;
        --accent: #8a4a2f;
        --ok: #2f6b45;
        --underline: #9c9482;
        --sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
        --mono: "JetBrainsMono Nerd Font", "JetBrainsMono Nerd Font Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        --tok-key: #8a4a2f;
        --tok-str: #3f6b4a;
        --tok-num: #77571a;
        --tok-fn: #41597f;
      }

      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #131416;
        --alt: #1b1d20;
        --fg: #e2e4e9;
        --dim: #8a8f98;
        --border: #2a2d31;
        --accent: #dd9b78;
        --ok: #7fc7a0;
        --underline: #727982;
        --tok-key: #dd9b78;
        --tok-str: #a9c39a;
        --tok-num: #d9c07a;
        --tok-fn: #9fb6d9;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--sans);
        font-size: 17.5px;
        line-height: 1.72;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .wrap {
        max-width: 42rem;
        margin: 0 auto;
        padding: 4rem 1.5rem 5.5rem;
        animation: rise 400ms ease-out both;
        animation-fill-mode: backwards;
      }

      .top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 3rem;
        font-family: var(--sans);
      }
      .brand {
        color: var(--fg);
        font-weight: 600;
        letter-spacing: -0.01em;
        text-decoration: none;
      }
      .nav {
        display: flex;
        align-items: baseline;
        gap: 1.1rem;
        font-size: 13.5px;
      }
      .nav a { color: var(--dim); text-decoration: none; }
      .nav a:hover,
      .nav a[aria-current="page"] {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      #theme-toggle {
        background: none;
        border: 0;
        padding: 0;
        font: inherit;
        font-size: 13px;
        color: var(--dim);
        cursor: pointer;
      }
      #theme-toggle:hover { color: var(--accent); }

      a {
        color: var(--fg);
        text-decoration: underline;
        text-decoration-color: var(--underline);
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
      }
      a:hover {
        color: var(--accent);
        text-decoration-color: var(--accent);
      }

      :where(a, button):focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }
      ::selection {
        background: var(--accent);
        color: var(--bg);
      }

      main p a {
        text-underline-offset: 4px;
        text-decoration-thickness: 1px;
        transition: color 150ms ease, text-decoration-thickness 150ms ease;
      }
      main p a:hover { text-decoration-thickness: 2px; }
      main p a.ep::after,
      main p a[target="_blank"]::after,
      .entry-desc a[target="_blank"]::after {
        content: "\2197";
        font-size: 0.72em;
        margin-left: 0.18em;
        color: var(--dim);
        text-decoration: none;
        display: inline-block;
        transform: translateY(-0.35em);
      }

      @keyframes rise {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: none; }
      }

      h1 {
        font-size: 1.75rem;
        font-weight: 650;
        margin: 0 0 1rem;
        letter-spacing: -0.022em;
      }
      h2 { font-size: 1.15rem; font-weight: 600; letter-spacing: -0.012em; }

      .lede { font-size: 17.5px; }

      .list { display: block; padding: 0; margin: 0; }
      .list > li { list-style: none; }
      .entry {
        display: block;
        padding: 0.62rem 0;
        border: 0;
        text-decoration: none;
        transition: opacity 180ms ease;
        content-visibility: auto;
        contain-intrinsic-size: 0 4.5rem;
      }
      .entry-row { display: flex; align-items: baseline; }
      .entry-name { font-size: 16px; font-weight: 600; letter-spacing: -0.012em; }
      .leader {
        flex: 1 1 auto;
        min-width: 1.5rem;
        margin: 0 0.7rem;
        border-bottom: 1px dotted var(--border);
        transform: translateY(-0.22em);
      }
      .entry-meta {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--dim);
        white-space: nowrap;
      }
      .entry-desc {
        display: block;
        font-size: 15px;
        color: var(--dim);
        margin-top: 0.12rem;
      }
      .list:has(.entry:hover) .entry { will-change: opacity; }
      .list:has(.entry:hover) .entry:not(:hover) { opacity: 0.5; }
      .entry:hover .entry-name { color: var(--accent); }
      .entry-name a { text-decoration: none; }
      .entry:hover .entry-name a { text-decoration: none; }

      .year-head {
        font-family: var(--sans);
        font-size: 1.35rem;
        font-weight: 650;
        letter-spacing: -0.02em;
        color: var(--fg);
        margin: 2.75rem 0 0.9rem;
      }
      .year-head:first-of-type { margin-top: 0; }

      .group {
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 600;
        color: var(--dim);
        margin: 1.1rem 0 0.5rem;
      }

      .empty { color: var(--dim); font-size: 15px; }

      @media (prefers-reduced-motion: reduce) {
        .wrap { animation: none; }
      }

      @media (max-width: 560px) {
        .top { gap: 0.6rem; margin-bottom: 2.2rem; }
        .wrap { padding: 2.75rem 1.1rem 4rem; }
        .entry-row { flex-wrap: wrap; }
        .leader {
          min-width: 2.5rem;
          order: 3;
          transform: none;
          margin: 0.15rem 0 0;
          flex-basis: 100%;
        }
        .entry-meta { margin-left: auto; }
        .year-head { margin: 2.25rem 0 0.7rem; }
      }

    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="top">
        <a class="brand" href="/">Nugraha</a>
        <nav class="nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.label}</a>
          ))}
          <button id="theme-toggle" type="button" aria-label="Switch theme" aria-pressed="false">dark</button>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        function sync() {
          var dark = document.documentElement.getAttribute("data-theme") === "dark";
          btn.textContent = dark ? "light" : "dark";
          btn.setAttribute("aria-pressed", String(dark));
          btn.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
        }
        btn.addEventListener("click", function () {
          var next =
            document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
