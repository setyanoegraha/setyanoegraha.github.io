---
const fullTitle = "Nugraha — IT & Security Portfolio";
const description =
  "Nugraha — computer engineering student at POLINES. IT and security internship candidate. Projects, labs and writeups.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="https://github.com/setyanoegraha.png" />
    <meta name="referrer" content="no-referrer" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nugraha" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="https://github.com/setyanoegraha.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://github.com/setyanoegraha.png" />
    <link rel="canonical" href={Astro.url} />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        var theme = saved === "dark" || saved === "light"
          ? saved
          : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #fcfbf8;
        --bg-alt: #f4f1ea;
        --fg: #1a1917;
        --dim: #6b6862;
        --border: #e2ded4;
        --accent: #8c3b25;
        --accent-ink: #6d2c1b;
        --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }

      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #16150f;
        --bg-alt: #1f1d16;
        --fg: #e8e4da;
        --dim: #9a958a;
        --border: #2f2c23;
        --accent: #d98d6b;
        --accent-ink: #e8a888;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: Charter, "Bitstream Charter", "Sitka Text", Cambria, Georgia, serif;
        font-size: 17px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .wrap {
        max-width: 46rem;
        margin: 0 auto;
        padding: 4.5rem 1.5rem 6rem;
      }

      .top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 3rem;
        font-family: var(--sans);
      }
      .brand {
        color: var(--fg);
        font-weight: 600;
        letter-spacing: -0.01em;
        text-decoration: none;
      }
      #theme-toggle {
        background: none;
        border: none;
        padding: 0;
        color: var(--dim);
        font: inherit;
        font-size: 13px;
        cursor: pointer;
      }
      #theme-toggle:hover { color: var(--accent); }

      .sec {
        border-top: 1px solid var(--border);
        padding-top: 1.75rem;
        margin-top: 2.5rem;
      }
      .sec--first {
        border-top: 0;
        padding-top: 0;
        margin-top: 0;
      }
      .sec-title {
        font-family: var(--sans);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--dim);
        margin: 0 0 1.25rem;
        display: flex;
        gap: 0.75rem;
        align-items: baseline;
      }
      .sec-num {
        color: var(--accent);
        font-variant-numeric: tabular-nums;
      }

      a {
        color: var(--fg);
        text-decoration: underline;
        text-decoration-color: var(--border);
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
      }
      a:hover {
        color: var(--accent);
        text-decoration-color: var(--accent);
      }

      :where(a, button):focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }
      ::selection {
        background: var(--accent);
        color: var(--bg);
      }

      h1 {
        font-size: 1.6rem;
        margin: 0 0 1rem;
        letter-spacing: -0.01em;
      }

      .status {
        display: grid;
        grid-template-columns: 9rem 1fr;
        gap: 0.5rem 1.5rem;
        margin: 0;
      }
      .status dt {
        font-family: var(--sans);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--dim);
        padding-top: 0.2rem;
      }
      .status dd { margin: 0; }
      @media (max-width: 560px) {
        .status { grid-template-columns: 1fr; gap: 0.15rem; }
        .status dd { margin-bottom: 0.6rem; }
      }

      .project {
        display: grid;
        grid-template-columns: 15rem 5rem 1fr;
        gap: 0 1rem;
        align-items: baseline;
        padding: 0.6rem 0;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
      }
      .project:last-child { border-bottom: 0; }
      .project-name {
        font-family: var(--sans);
        font-size: 14px;
        font-weight: 600;
      }
      .project-meta {
        font-family: var(--sans);
        font-size: 12px;
        color: var(--dim);
      }
      .project-desc {
        font-size: 15px;
        color: var(--dim);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .project:hover .project-name {
        color: var(--accent);
        text-decoration: underline;
      }
      @media (max-width: 640px) {
        .project { grid-template-columns: 1fr; gap: 0.1rem; }
        .project-meta { display: none; }
      }

      .project--writing {
        grid-template-columns: 13rem 1fr;
      }
      .project--writing .project-name { font-weight: 500; }
      @media (max-width: 640px) {
        .project--writing { grid-template-columns: 1fr; }
      }

      .write-count {
        font-family: var(--sans);
        font-size: 12px;
        color: var(--dim);
      }

      .achv {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
      }
      .achv li {
        border-left: 2px solid var(--border);
        padding-left: 1rem;
      }
      .achv-detail {
        display: block;
        font-size: 15px;
        color: var(--dim);
      }

      .contact {
        font-family: var(--sans);
        font-size: 14px;
      }

      footer {
        margin-top: 4rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
        font-family: var(--sans);
        font-size: 12px;
        color: var(--dim);
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="top">
        <a class="brand" href="/">Nugraha</a>
        <button id="theme-toggle" type="button" aria-label="Switch theme" aria-pressed="false">dark</button>
      </header>
      <main>
        <slot />
      </main>
      <footer>© {new Date().getFullYear()} Nugraha · built with Astro</footer>
    </div>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        function sync() {
          var dark = document.documentElement.getAttribute("data-theme") === "dark";
          btn.textContent = dark ? "light" : "dark";
          btn.setAttribute("aria-pressed", String(dark));
          btn.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
        }
        btn.addEventListener("click", function () {
          var next =
            document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
