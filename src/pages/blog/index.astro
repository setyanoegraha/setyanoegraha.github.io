---
import Base from "../../layouts/Base.astro";

const GITHUB_USER = "setyanoegraha";

const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

const TOKEN =
  process.env.GITHUB_TOKEN ?? (import.meta.env.GITHUB_TOKEN as string | undefined);
let useToken = !!TOKEN && !TOKEN.includes("isi_token");

async function gh<T>(url: string): Promise<T> {
  let lastErr: unknown;
  for (let attempt = 1; attempt <= 3; attempt++) {
    try {
      const r = await fetch(url, {
        headers: useToken ? { Authorization: `Bearer ${TOKEN}` } : {},
      });
      if (r.ok) return (await r.json()) as T;
      lastErr = new Error(`HTTP ${r.status}`);
      if (r.status === 401) {
        useToken = false;
        continue;
      }
      if (r.status < 500 && r.status !== 429) break;
    } catch (e) {
      lastErr = e;
    }
    if (attempt < 3) await sleep(2000 * attempt);
  }
  throw lastErr;
}

interface Repo {
  name: string;
  pushed_at: string;
  default_branch: string;
}
interface Entry {
  name: string;
  type: string;
}
interface IndexedRepo {
  name: string;
  branch: string;
  prefix: string;
  machines: string[];
}

const SHOWCASED_WRITEUPS = [
  "hackmyvm-writeups",
  "vulnyx-writeups",
  "dockerlabs-writeups",
];

let repos: IndexedRepo[] = [];
let error: string | null = null;

try {
  const all = await gh<Repo[]>(
    `https://api.github.com/users/${GITHUB_USER}/repos?sort=pushed&per_page=100`
  );
  const writeups = all
    .filter((r) => SHOWCASED_WRITEUPS.includes(r.name))
    .sort((a, b) => b.pushed_at.localeCompare(a.pushed_at));

  for (const repo of writeups) {
    let entries = await gh<Entry[]>(
      `https://api.github.com/repos/${GITHUB_USER}/${repo.name}/contents/`
    );
    const hasMachinesDir = entries.some(
      (e) => e.type === "dir" && e.name === "machines"
    );
    if (hasMachinesDir) {
      entries = await gh<Entry[]>(
        `https://api.github.com/repos/${GITHUB_USER}/${repo.name}/contents/machines`
      );
    }
    repos.push({
      name: repo.name,
      branch: repo.default_branch,
      prefix: hasMachinesDir ? "machines/" : "",
      machines: entries
        .filter((e) => e.type === "dir" && !e.name.startsWith("."))
        .sort((a, b) => a.name.toLowerCase().localeCompare(b.name.toLowerCase()))
        .map((e) => e.name),
    });
  }
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}
---
<Base>
  <h1>Blog</h1>
  {error ? (
    <p>
      writeups are on <a href="https://github.com/setyanoegraha?tab=repositories" target="_blank" rel="noopener">GitHub</a>.
    </p>
  ) : (
    repos.map((repo) => (
      <section class="repo">
        <h2>{repo.name}</h2>
        <ul>
          {repo.machines.map((m) => (
            <li>
              <a
                href={`https://github.com/${GITHUB_USER}/${repo.name}/tree/${repo.branch}/${repo.prefix}${m}`}
                target="_blank"
                rel="noopener"
              >{m}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}

  <style>
    .repo { margin-bottom: 2rem; }
    .repo h2 {
      font-size: 0.95rem;
      color: var(--yellow);
      margin: 0 0 0.5rem;
      font-weight: 600;
    }
    .repo ul { list-style: none; padding: 0; margin: 0; }
    .repo li { padding: 0.15rem 0; }
  </style>
</Base>
