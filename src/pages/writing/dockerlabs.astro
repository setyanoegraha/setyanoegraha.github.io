---
import WritingPlatform from "../../layouts/WritingPlatform.astro";
import writeupsFallback from "../../data/writeups.json";

const REPO_NAME = "dockerlabs-writeups";
const GITHUB_USER = "setyanoegraha";

interface Repo {
  name: string;
  default_branch: string;
}
interface Entry {
  name: string;
  type: string;
}
interface IndexedRepo {
  name: string;
  branch: string;
  prefix: string;
  machines: string[];
}

const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
const TOKEN = process.env.GITHUB_TOKEN ?? (import.meta.env.GITHUB_TOKEN as string | undefined);
let useToken = !!TOKEN && !TOKEN.includes("isi_token");

async function gh<T>(url: string): Promise<T> {
  let lastErr: unknown;
  for (let attempt = 1; attempt <= 3; attempt++) {
    try {
      const r = await fetch(url, {
        headers: useToken ? { Authorization: `Bearer ${TOKEN}` } : {},
      });
      if (r.ok) return (await r.json()) as T;
      lastErr = new Error(`HTTP ${r.status}`);
      if (r.status === 401) { useToken = false; continue; }
      if (r.status < 500 && r.status !== 429) break;
    } catch (e) { lastErr = e; }
    if (attempt < 3) await sleep(2000 * attempt);
  }
  throw lastErr;
}

let branch = "main";
let prefix = "";
let machines: string[] = [];

try {
  const all = await gh<Repo[]>(`https://api.github.com/users/${GITHUB_USER}/repos?sort=pushed&per_page=100`);
  const repo = all.find((r) => r.name === REPO_NAME);
  if (repo) {
    const entries = await gh<Entry[]>(`https://api.github.com/repos/${GITHUB_USER}/${REPO_NAME}/contents/`);
    branch = repo.default_branch;
    machines = entries
      .filter((e) => e.type === "dir" && !e.name.startsWith("."))
      .sort((a, b) => a.name.toLowerCase().localeCompare(b.name.toLowerCase()))
      .map((e) => e.name);
  }
} catch {
  const snap = (writeupsFallback as IndexedRepo[]).find((r) => r.name === REPO_NAME);
  if (snap) {
    branch = snap.branch;
    prefix = snap.prefix;
    machines = snap.machines;
  }
}

if (machines.length === 0) {
  const snap = (writeupsFallback as IndexedRepo[]).find((r) => r.name === REPO_NAME);
  if (snap) {
    branch = snap.branch;
    prefix = snap.prefix;
    machines = snap.machines;
  }
}
---
<WritingPlatform
  repoName={REPO_NAME}
  repoLabel="DockerLabs walkthroughs"
  branch={branch}
  prefix={prefix}
  machines={machines}
/>
