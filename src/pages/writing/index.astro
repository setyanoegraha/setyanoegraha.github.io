---
import Base from "../../layouts/Base.astro";
import { posts } from "../../data/posts";
---
<Base>
  <p>Thoughts, random notes, and lab walkthroughs.</p>

  <section class="writing-section" id="notes-section">
    <h2 class="section-head">Thoughts</h2>
    <p class="section-intro">Short essays, loose ideas, and whatever happens to be on my mind.</p>
    {posts.length === 0 ? (
      <p class="empty">Nothing written here yet. Lab walkthroughs are available below.</p>
    ) : (
      <ul class="list post-list">
        {posts.map((post) => (
          <li>
            {post.externalUrl ? (
              <a class="entry" href={post.externalUrl} target="_blank" rel="noopener">
                <span class="entry-name">{post.title}</span>
                {post.summary && <span class="entry-desc">{post.summary}</span>}
              </a>
            ) : (
              <a class="entry" href={`/writing/${post.slug}`}>
                <span class="entry-name">{post.title}</span>
                {post.summary && <span class="entry-desc">{post.summary}</span>}
              </a>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="writing-section" id="archive-section">
    <h2 class="section-head">Walkthroughs</h2>
    <p class="lede">
      Writing down how a system breaks is the best way to understand how it works. I keep step-by-step compromise notes across <a href="/writing/hackmyvm">HackMyVM boxes</a>, <a href="/writing/dockerlabs">DockerLabs containers</a>, and <a href="/writing/vulnyx">VulNyx machines</a>, documenting everything from initial enumeration to root.
    </p>
  </section>
</Base>

<style>
  .writing-section {
    margin-top: 2rem;
  }
  .section-head {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }
  .section-intro {
    margin: 0 0 0.65rem;
  }
  .post-list .entry {
    padding: 0.25rem 0;
  }
</style>
