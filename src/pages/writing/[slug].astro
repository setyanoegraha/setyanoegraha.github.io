---
import Base from "../../layouts/Base.astro";
import BackIcon from "../../components/BackIcon.astro";
import { posts, type Post } from "../../data/posts";
import { marked } from "marked";

export async function getStaticPaths() {
  if (posts.length === 0) {
    // Keep build passing cleanly when zero posts exist
    return [
      {
        params: { slug: "sample-note" },
        props: {
          isPlaceholder: true,
          post: {
            title: "Sample Note",
            date: "2026-11-04",
            summary: "Placeholder note.",
            category: "Note",
            slug: "sample-note",
            content: "This is a placeholder note.",
          } as Post,
        },
      },
    ];
  }

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { isPlaceholder: false, post },
  }));
}

interface Props {
  isPlaceholder: boolean;
  post: Post;
}

const { isPlaceholder, post } = Astro.props;
const htmlContent = post.content ? marked.parse(post.content) : "";
---
<Base>
  {isPlaceholder ? (
    <article class="post-single">
      <h1>Note in preparation</h1>
      <p class="empty">This note is currently in preparation. <a href="/writing">← Back to writing</a>.</p>
    </article>
  ) : (
    <article class="post-single">
      <div class="back-row">
        <BackIcon href="/writing" label="Back to writing" />
      </div>
      <header class="post-header">
        <div class="post-meta-row">
          <time class="post-date">{post.date}</time>
        </div>
        <h1>{post.title}</h1>
        {post.summary && <p class="post-lead">{post.summary}</p>}
      </header>
      <div class="post-content" set:html={htmlContent} />
      <div class="back-footer">
        <BackIcon href="/writing" label="Back to writing" />
      </div>
    </article>
  )}

  <style>
    .post-single {
      margin-top: 0.25rem;
    }
    .post-header {
      margin-bottom: 1.65rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.1rem;
    }
    .post-header h1 {
      margin-bottom: 0;
    }
    .post-meta-row {
      margin-bottom: 0.4rem;
    }
    .post-date {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--dim);
    }
    .post-lead {
      font-size: 18px;
      color: var(--dim);
      margin: 0.5rem 0 0;
    }
    .post-content {
      font-size: 17.5px;
      line-height: 1.75;
    }
    .post-content :global(p) {
      margin: 0 0 1.25em;
    }
  </style>
</Base>
