---
import Base from "../../layouts/Base.astro";
import { projects } from "../../data/projects";

const sorted = [...projects].sort((a, b) => b.date.localeCompare(a.date));
const years: { year: string; items: typeof sorted }[] = [];
for (const p of sorted) {
  const [y] = p.date.split("-");
  let year = years.at(-1);
  if (!year || year.year !== y) {
    year = { year: y, items: [] };
    years.push(year);
  }
  year.items.push(p);
}
---
<Base>
  <p>
    Command-line utilities and web applications I've built, mostly to automate repetitive terminal work and solve practical problems.
  </p>
  {years.map(({ year, items }) => (
    <>
      <h2 class="year-head">{year}</h2>
      <ul class="list">
        {items.map((p) => (
          <li>
            <a class="entry" href={`/projects/${p.slug}`}>
              <span class="entry-name">{p.name}</span>
              <span class="entry-desc">{p.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  ))}
</Base>
