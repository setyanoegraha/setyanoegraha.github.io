---
import Base from "../../layouts/Base.astro";
import { profile } from "../../data/profile";

const sorted = [...profile.projects].sort((a, b) => b.date.localeCompare(a.date));
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const years: { year: string; months: { key: string; label: string; items: typeof sorted }[] }[] = [];
for (const p of sorted) {
  const [y, m] = p.date.split("-");
  let year = years.at(-1);
  if (!year || year.year !== y) {
    year = { year: y, months: [] };
    years.push(year);
  }
  const lastMonth = year.months.at(-1);
  if (lastMonth && lastMonth.key === p.date) lastMonth.items.push(p);
  else year.months.push({ key: p.date, label: MONTHS[Number(m) - 1], items: [p] });
}
const escapeHtml = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const linkify = (text: string) =>
  escapeHtml(text).replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
---
<Base>
  <h1>Projects</h1>
  <p>
    Command-line utilities and web applications I've built, mostly to automate repetitive terminal work and solve practical problems.
  </p>
  {years.map(({ year, months }) => (
    <>
      <h2 class="year-head">{year}</h2>
      {months.map(({ label, items }) => (
        <>
          <h3 class="group">{label}</h3>
          <ul class="list">
            {items.map((p) => (
              <li>
                <div class="entry">
                  <span class="entry-name">
                    <a href={p.url} target="_blank" rel="noopener">{p.name}</a>
                  </span>
                  <span class="entry-desc" set:html={linkify(p.description)} />
                </div>
              </li>
            ))}
          </ul>
        </>
      ))}
    </>
  ))}
</Base>

<style>
  .entry-name a {
    color: var(--fg);
    text-decoration: none;
  }
  .entry:hover .entry-name a,
  .entry-name a:hover {
    color: var(--accent);
  }
  .entry-desc :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--underline);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .entry-desc :global(a:hover) {
    color: var(--accent);
  }
</style>
