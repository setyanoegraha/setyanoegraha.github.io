---
import Base from "../../layouts/Base.astro";
import { milestones } from "../../data/milestones";

const sorted = [...milestones].sort((a, b) => b.date.localeCompare(a.date));
const years: { year: string; items: typeof sorted }[] = [];
for (const m of sorted) {
  const [y] = m.date.split("-");
  let year = years.at(-1);
  if (!year || year.year !== y) {
    year = { year: y, items: [] };
    years.push(year);
  }
  year.items.push(m);
}
---
<Base>
  <p>Security labs I built and documentation milestones over time.</p>
  {sorted.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    years.map(({ year, items }) => (
      <>
        <h2 class="year-head">{year}</h2>
        <ul class="list">
          {items.map((m) => (
            <li>
              <a class="entry" href={`/milestones/${m.slug}`}>
                <span class="entry-name">{m.title}</span>
                <span class="entry-desc">{m.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    ))
  )}
</Base>
