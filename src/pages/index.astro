---
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";

const HIGHLIGHTS = [
  "ledger-tui",
  "revshell-tui",
  "webapp_osce",
  "hackmyvm-commandlineinterface",
];
const highlights = profile.projects.filter((p) => HIGHLIGHTS.includes(p.name));
---
<Base>
  <h2>Introduction</h2>
  <p>
    I'm <strong>{profile.name}</strong>, a {profile.tagline} Most of my time
    goes into hands-on security labs — 260+ completed across public platforms.
  </p>

  <h2>Status</h2>
  <ul>
    {profile.status.map((s) => <li>{s}</li>)}
  </ul>

  <h2>Projects</h2>
  <ul>
    {highlights.map((p) => (
      <li>
        <a href={p.url} target="_blank" rel="noopener">{p.name}</a>
      </li>
    ))}
  </ul>
  <p><a href="/projects">see all projects →</a></p>

  <h2>Achievements</h2>
  <ul>
    {profile.achievements.map((a) => (
      <li>
        {a.url ? <a href={a.url}>{a.title}</a> : <strong>{a.title}</strong>}
        {" — "}{a.detail}
      </li>
    ))}
  </ul>

  <h2>Blog</h2>
  <p>
    Full walkthroughs of every lab I complete — <a href="/blog">read the blog →</a>
  </p>

  <h2>Contact</h2>
  <ul>
    <li><a href={profile.links.github} target="_blank" rel="noopener">github</a></li>
    <li><a href={profile.links.linkedin} target="_blank" rel="noopener">linkedin</a></li>
    <li><a href={`mailto:${profile.links.email}`}>email</a></li>
  </ul>
</Base>
